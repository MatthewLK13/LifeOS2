# Point development and preview deployments at an isolated Neon development branch.
DATABASE_ENV=development
DATABASE_URL=
NEON_DEV_DB_HOST=

# Generate two distinct random values (32+ characters each); never commit real values.
SESSION_SECRET=
PLAYER_CODE_PEPPER=

# Optional during Phase 0 and Phase 1.
GEMINI_API_KEY=
AI_PRIMARY_MODEL=gemini-3.8-flash
AI_BACKGROUND_MODEL=gemini-3.5-flash-lite
GLOBAL_AI_WEEKLY_BUDGET_USD=2
PLAYER_AI_WEEKLY_TOKEN_LIMIT=250000
DEMO_AI_WEEKLY_TOKEN_LIMIT=500000

MAX_PASTE_BYTES=204800
FULL_SESSION_RETENTION=5
SUMMARY_RETENTION=20
ADMIN_SECRET=
CRON_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:replace@example.com
APP_BASE_URL=http://localhost:4173
APP_TIMEZONE=Asia/Ho_Chi_Minh
PORT=4173
API_PORT=4174
