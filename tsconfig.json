{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "lib": ["ES2023", "DOM"]
  },
  "include": ["server/**/*.ts", "api/**/*.ts", "drizzle.config.ts", "shared/catalog/**/*.mjs", "src/**/*.js"],
  "exclude": ["node_modules", "dist", "server/db/migrations"]
}
